{
  "version": 1,
  "purpose": "Short-form vertical video handoff contract",
  "output": {
    "container": "mp4",
    "video_codec": "h264",
    "audio_codec": "aac",
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16",
    "fps": 30,
    "preferred_duration_seconds": {
      "min": 30,
      "max": 60
    },
    "absolute_max_duration_seconds": 180,
    "audio_sample_rate_hz": 48000
  },
  "required_metadata": [
    "id",
    "date",
    "title",
    "description",
    "source_theme",
    "file"
  ],
  "safety": {
    "copyright_cleared_assets_only": true,
    "no_unlicensed_music": true,
    "no_face_or_voice_required": true,
    "default_upload_privacy": "private",
    "generation_enabled": false
  }
}
